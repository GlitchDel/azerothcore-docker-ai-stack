     # Docker Compose MySQL port override (resolves conflict with local MySQL 3306)
     DOCKER_DB_EXTERNAL_PORT=3308

     # AzerothCore SOAP & Chat Log settings
     WOW_CHAT_LOG_PATH=/path/to/WoW/Logs/WoWChatLog.txt
     SOAP_HOST=127.0.0.1
     SOAP_PORT=7878
     SOAP_USER=your_gm_account
     SOAP_PASS=your_gm_password

     # Local Ollama API settings
     OLLAMA_URL=http://127.0.0.1:11434/api/chat
     OLLAMA_MODEL=gemma-chat:latest
     BOT_NAME=Tempest
